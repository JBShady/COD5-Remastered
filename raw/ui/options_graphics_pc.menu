	menuDef
	{
		name			options_graphics_texture
		fullScreen		0
		rect			0 0 640 480
		focusColor		COLOR_FOCUSED
		soundloop		""
		onOpen
		{
			setLocalVarBool ui_hideBack 1;
			setLocalVarBool ui_showApply 0;

			exec "setfromdvar ui_r_picmip			r_picmip";
			exec "setfromdvar ui_r_picmip_bump		r_picmip_bump";
			exec "setfromdvar ui_r_picmip_spec		r_picmip_spec";
			exec "setfromdvar ui_r_picmip_manual	r_picmip_manual";	
		}
		onClose
		{
			setLocalVarBool ui_hideBack 0;
		}

		onESC
		{
			execOnDvarIntValue cl_ingame 1 "setfromdvar safeArea_vertical safeArea_ui";
			execOnDvarIntValue cl_ingame 1 "setfromdvar safeArea_horizontal safeArea_ui";
			//exec "setfromdvar cg_draw2D cg_draw2D_ui"; // reset
			close self;
			//open options_graphics;
		}
		#define 	CHOICE_SEP_1		24
		#define 	CHOICE_SEP_2		27
		#include "ui/choices_setup_common.menu"

		#include "ui_mp/leftside_options.inc"

		CHOICE_SECTION_TITLE( 21, "@MENU_TEXTURE_SETTINGS_CAP" )

		CHOICE_DVARSTRINGLIST( 22, "@MENU_TEXTURE_MIPMAPS", r_texFilterMipMode, { "@MENU_AUTOMATIC"; "Unchanged"; "@MENU_BILINEAR"; "Force Bilinear"; "@MENU_TRILINEAR"; "Force Trilinear" }, setLocalVarBool ui_showApply 1 )
		CHOICE_DVARFLOATLIST( 23, "@REMASTERED_ANISO", r_texFilterAnisoMax, { "@MENU_LOW" 4 "@MENU_NORMAL" 16 }, setLocalVarBool ui_showApply 1 )
		CHOICE_DVARSLIDER( 24, "@MENU_TEXTURE_ANISOTROPY", r_texFilterAnisoMin, 1, 1, 16, setLocalVarBool ui_showApply 1 )
		

		CHOICE_SEPARATOR(CHOICE_SEP_1)

		//when on menu, we are just changing the dummy var because our client script will set the actual 2 dvars
		CHOICE_DVARFLOATLIST_VIS( 25, "@REMASTERED_LOD_RIGID", r_lodBiasRigid_settings, { "@MENU_LOW" 0 "@MENU_NORMAL" -200 "@MENU_HIGH" -500 }, ; , when( !dvarint(cl_ingame) && dvarInt( version_t4me) == 0 ) ) // Increases LOD bias for detailed models
		CHOICE_DVARFLOATLIST_VIS( 26, "@REMASTERED_LOD_SKINNED", r_lodBiasSkinned_settings, { "@MENU_LOW" 0 "@MENU_NORMAL" -200 "@MENU_HIGH" -500 }, ; , when( !dvarint(cl_ingame) && dvarInt( version_t4me) == 0 ) ) // Increases LOD bias for detailed models

		//however, when we are in game we will edit the actual settings
		CHOICE_DVARFLOATLIST_VIS( 25, "@REMASTERED_LOD_RIGID", r_lodBiasRigid, { "@MENU_LOW" 0 "@MENU_NORMAL" -200 "@MENU_HIGH" -500 }, exec "setfromdvar r_lodBiasRigid_settings r_lodBiasRigid" , when( dvarint(cl_ingame) && dvarInt( version_t4me) == 0 ) ) 
		CHOICE_DVARFLOATLIST_VIS( 26, "@REMASTERED_LOD_SKINNED", r_lodBiasSkinned, { "@MENU_LOW" 0 "@MENU_NORMAL" -200 "@MENU_HIGH" -500 }, exec "setfromdvar r_lodBiasSkinned_settings r_lodBiasSkinned" , when( dvarint(cl_ingame) && dvarInt( version_t4me) == 0 ) ) 
		

		//when on menu, we are just changing the dummy var because our client script will set the actual 2 dvars
		CHOICE_DVARFLOATLIST_VIS( 25, "@REMASTERED_LOD_RIGID", r_lodBiasRigid_settings, { "@MENU_LOW" 0 "@MENU_NORMAL" -200 "@MENU_HIGH" -500 "@MENU_INSANE" -1000 }, ; , when( !dvarint(cl_ingame) && dvarInt( version_t4me) > 48 ) ) // Increases LOD bias for detailed models
		CHOICE_DVARFLOATLIST_VIS( 26, "@REMASTERED_LOD_SKINNED", r_lodBiasSkinned_settings, { "@MENU_LOW" 0 "@MENU_NORMAL" -200 "@MENU_HIGH" -500 "@MENU_INSANE" -1000 }, ; , when( !dvarint(cl_ingame) && dvarInt( version_t4me) > 48 ) ) // Increases LOD bias for detailed models

		//however, when we are in game we will edit the actual settings
		CHOICE_DVARFLOATLIST_VIS( 25, "@REMASTERED_LOD_RIGID", r_lodBiasRigid, { "@MENU_LOW" 0 "@MENU_NORMAL" -200 "@MENU_HIGH" -500 "@MENU_INSANE" -1000 }, exec "setfromdvar r_lodBiasRigid_settings r_lodBiasRigid" , when( dvarint(cl_ingame) && dvarInt( version_t4me) > 48 ) ) 
		CHOICE_DVARFLOATLIST_VIS( 26, "@REMASTERED_LOD_SKINNED", r_lodBiasSkinned, { "@MENU_LOW" 0 "@MENU_NORMAL" -200 "@MENU_HIGH" -500 "@MENU_INSANE" -1000 }, exec "setfromdvar r_lodBiasSkinned_settings r_lodBiasSkinned" , when( dvarint(cl_ingame) && dvarInt( version_t4me) > 48 ) ) 
		
		CHOICE_DVARYESNO( 27, "@MENU_OPTION_BULLET_IMPACTS", fx_marks, ; )

		CHOICE_SEPARATOR(CHOICE_SEP_2)


		CHOICE_DVARYESNO( 28, "@MENU_SPECULAR_MAP", r_specular, ; )
		CHOICE_DVARFLOATLIST( 29, "@MENU_TEXTURE_QUALITY", ui_r_picmip_manual, { "@MENU_AUTOMATIC" 0 "@MENU_MANUAL" 1 }, setLocalVarBool ui_showApply 1 )
		CHOICE_DVARFLOATLIST_VIS( 30, "@MENU_TEXTURE_RESOLUTION", ui_r_picmip, { "@MENU_LOW" 3 "@MENU_NORMAL" 2 "@MENU_HIGH" 1 "@MENU_EXTRA" 0 }, setLocalVarBool ui_showApply 1, when( dvarint( ui_r_picmip_manual ) ) )
		CHOICE_DVARFLOATLIST_VIS( 31, "@MENU_NORMAL_MAP_RESOLUTION", ui_r_picmip_bump, { "@MENU_LOW" 3 "@MENU_NORMAL" 2 "@MENU_HIGH" 1 "@MENU_EXTRA" 0 }, setLocalVarBool ui_showApply 1, when( dvarint( ui_r_picmip_manual ) ) )
		CHOICE_DVARFLOATLIST_VIS( 32, "@MENU_SPECULAR_MAP_RESOLUTION", ui_r_picmip_spec, { "@MENU_LOW" 3 "@MENU_NORMAL" 2 "@MENU_HIGH" 1 "@MENU_EXTRA" 0 }, setLocalVarBool ui_showApply 1, when( dvarint( ui_r_picmip_manual ) ) )
	



		//CHOICE_DDVARALTTEXT_VIS( 24, "@REMASTERED_LOD", "@REMASTERED_DETAIL", when( INGAME && dvarString( "lod_bias_enable") == "0" ) )
		//CHOICE_DDVARALTTEXT_VIS( 24, "@REMASTERED_LOD", "@REMASTERED_LOW_DETAIL", when( INGAME && dvarString( "lod_bias_enable") == "1" ) )

		itemDef 
		{
			name			apply
			text			"@MENU_APPLY"
			type			1
			style			WINDOW_STYLE_FILLED
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			rect			200 -26 80 20 HORIZONTAL_ALIGN_CENTER VERTICAL_ALIGN_BOTTOM
			textfont		UI_FONT_NORMAL
			textalign		ITEM_ALIGN_LEFT
			textscale		TEXTSIZE_SMALL
			textaligny		18
			visible			when( localVarBool( ui_showApply ) );
			mouseEnter		{ play "mouse_over"; }
			action 
			{
				play "mouse_click";
				close self; 
				open apply_picmip_popmenu;
			}	
		}
		//CHOICE_APPLY_VIS( "@MENU_APPLY", close self; open apply_picmip_popmenu, when( localVarBool( ui_showApply ) ) )
		
		//CHOICE_BACK( "@MENU_BACK", close self; open options_graphics )

		/*
		itemDef 
		{
			name			graphic_warning
			text			"@MENU_GRAPHICS_WARNING"
			type			1
			style			WINDOW_STYLE_FILLED
			textstyle		ITEM_TEXTSTYLE_SHADOWED
			rect			20 -116 240 240 HORIZONTAL_ALIGN_LEFT VERTICAL_ALIGN_BOTTOM
			textfont		UI_FONT_NORMAL
			textalign		ITEM_ALIGN_LEFT
			textscale		TEXTSIZE_SMALL
			visible			1
			mouseEnter		{ play "mouse_over"; }
			decoration
			autowrapped
		}
		*/
		//CHOICE_FOOTNOTE( "@MENU_GRAPHICS_WARNING", 340, 340 )
	}

	menuDef
	{
		name			apply_picmip_popmenu
		fullScreen		0
		rect			0 0 640 480
		focusColor		COLOR_FOCUSED
		soundloop		""
		onOpen
		{
			setLocalVarBool ui_showApply 0;

			execnow "setfromdvar r_picmip ui_r_picmip";
			execnow "setfromdvar r_picmip_bump ui_r_picmip_bump";
			execnow "setfromdvar r_picmip_spec ui_r_picmip_spec";
			execnow "setfromdvar r_picmip_manual ui_r_picmip_manual";
			exec "wait; wait; r_applyPicmip";
			close apply_picmip_popmenu;
			open options_graphics_texture;
		}
		
		// background black frame
		PREPROC_SHADER_DRAW( ORIGIN_OPTIONS_FRAME 600 480, 100 0, "white", 0.1 0.1 0.12 1, 0, 1, 0 0 0 0 )
		
		CHOICE_SECTION_TITLE( 1, "@MENU_APPLYING_CHANGES" )
	}
}
