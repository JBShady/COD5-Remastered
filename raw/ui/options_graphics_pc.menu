		CHOICE_DDVARALTTEXT_VIS( 24, "@MENU_ASPECT_RATIO", "@MENU_WIDE_16_9", when( dvarString( "r_aspectratio" ) == "wide 16:9" && dvarBool( cl_ingame ) ) )
